resource "aws_glue_job" "glue_kafka_etl_batch" {
  name              = "glue_kafka_etl_batch"
  role_arn          = var.glue_iam_role_arn
  glue_version      = "5.1"
  worker_type       = "G.1X"
  number_of_workers = 10
  max_retries       = 0
  timeout           = 480

  command {
    name            = "glueetl"
    script_location = "${local.script_location}glue_kafka_etl_batch.py"
    python_version  = "3"
  }

  default_arguments = merge(local.common_default_arguments, {
    "--batch_size"      = "200"
    "--dynamodb_table"  = "kafka_file_tracking"
    "--max_retry_count" = "3"
    "--s3_folder"       = "ALL"
    "--extra-py-files"  = "s3://${var.data_bucket}/data/glue_job/glue_app_deps.zip"
  })

  execution_property {
    max_concurrent_runs = 20
  }

  tags       = local.full_tags
  depends_on = [aws_glue_catalog_database.ops_db_s3_redshift]
}
