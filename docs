THUMBPRINT=$(openssl s_client -servername oidc.eks.us-east-2.amazonaws.com \
  -connect oidc.eks.us-east-2.amazonaws.com:443 2>/dev/null \
  | openssl x509 -fingerprint -noout | cut -d'=' -f2 | tr -d ':' | tr '[:upper:]' '[:lower:]')

aws iam create-open-id-connect-provider \
  --url https://oidc.eks.us-east-2.amazonaws.com/id/4804356930378C9FBD842F9BA435AB05 \
  --client-id-list sts.amazonaws.com \
  --thumbprint-list $THUMBPRINT
