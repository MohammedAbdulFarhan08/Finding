{
  "PermissionSetName": "OptumCloud-RedshiftReadOnly-QueryEditor",
  "Description": "Read-only AWS access plus Redshift Serverless Query Editor v2 access. SQL-level read-only enforced via database GRANTs.",
  "SessionDuration": "PT1H",
  "AwsManagedPolicies": [
    "arn:aws:iam::aws:policy/ReadOnlyAccess",
    "arn:aws:iam::aws:policy/AmazonRedshiftQueryEditorV2NoSharing"
  ],
  "InlinePolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowConnectToServerlessWorkgroup",
        "Effect": "Allow",
        "Action": [
          "redshift-serverless:GetCredentials"
        ],
        "Resource": "arn:aws:redshift-serverless:us-east-2:064977599863:workgroup/fd4cb30e-85d0-4bbf-bb6b-13dddeb66913"
      },
      {
        "Sid": "AllowQueryEditorV2DescribeAndDataApi",
        "Effect": "Allow",
        "Action": [
          "redshift-serverless:ListWorkgroups",
          "redshift-serverless:ListNamespaces",
          "redshift-serverless:GetWorkgroup",
          "redshift-serverless:GetNamespace",
          "redshift-data:ExecuteStatement",
          "redshift-data:BatchExecuteStatement",
          "redshift-data:CancelStatement",
          "redshift-data:DescribeStatement",
          "redshift-data:GetStatementResult",
          "redshift-data:ListStatements",
          "redshift-data:ListDatabases",
          "redshift-data:ListSchemas",
          "redshift-data:ListTables",
          "redshift-data:DescribeTable"
        ],
        "Resource": "*"
      },
      {
        "Sid": "DenyServerlessWriteOperations",
        "Effect": "Deny",
        "Action": [
          "redshift-serverless:CreateNamespace",
          "redshift-serverless:DeleteNamespace",
          "redshift-serverless:UpdateNamespace",
          "redshift-serverless:CreateWorkgroup",
          "redshift-serverless:DeleteWorkgroup",
          "redshift-serverless:UpdateWorkgroup",
          "redshift-serverless:CreateSnapshot",
          "redshift-serverless:DeleteSnapshot",
          "redshift-serverless:RestoreFromSnapshot",
          "redshift-serverless:TagResource",
          "redshift-serverless:UntagResource"
        ],
        "Resource": "*"
      }
    ]
  }
}
