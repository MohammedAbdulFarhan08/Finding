# Create the policy
cat <<'EOF' > /tmp/policy.json
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-2:064977599863:secret:onepass-eks/pass-utilization-*"
    }
  ]
}
EOF

aws iam create-policy \
  --policy-name pass-utilization-secrets-policy \
  --policy-document file:///tmp/policy.json

# Create the role with Pod Identity trust
cat <<'EOF' > /tmp/trust.json
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ]
    }
  ]
}
EOF

aws iam create-role \
  --role-name pass-utilization-secrets-role \
  --assume-role-policy-document file:///tmp/trust.json

# Attach the policy
aws iam attach-role-policy \
  --role-name pass-utilization-secrets-role \
  --policy-arn arn:aws:iam::064977599863:policy/pass-utilization-secrets-policy




